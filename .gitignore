# =============================================================================
# mcp-kicad-vscode — .gitignore da raiz do workspace
#
# Escopo: cobre o monorepo inteiro (KiCAD-MCP-Server, project-kicad, artigo,
# monografia, evidencias). Os subprojetos KiCAD-MCP-Server/, artigo/ e
# monografia/ possuem .gitignore próprios; as regras daqui são a rede de
# segurança do nível superior.
#
# Regra de ouro: artefatos gerados/regeneráveis ficam FORA; fontes, evidências
# e entregáveis finais (PDFs, vídeo, bibliotecas, relatórios de DRC) ficam DENTRO.
# =============================================================================

# -----------------------------------------------------------------------------
# KiCAD-MCP-Server — Node.js / TypeScript
# -----------------------------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.prettiercache

# -----------------------------------------------------------------------------
# KiCAD-MCP-Server — Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
*.egg-info/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
coverage.xml
htmlcov/
.tox/
.hypothesis/
*.cover

# Ambientes virtuais
venv/
.venv/
env/
ENV/

# -----------------------------------------------------------------------------
# VS Code e editores (configurações locais/máquina-específicas)
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# LaTeX (artigo/ e monografia/) — artefatos de compilação
# Mantém versionados: .tex, .bib, PDFs finais, figuras e scripts de build.
# -----------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.loq
*.fls
*.fdb_latexmk
*.synctex.gz
*.bcf
*.run.xml
*-blx.bib
latex.out/
.texpadtmp/

# Evidências — exceção intencional:
# evidencias/ guarda prova de execução (testes, DRC) citada no README.md, no
# artigo e nos apêndices da monografia; por isso os logs NÃO são ignorados.
!evidencias/*.log

# -----------------------------------------------------------------------------
# Projetos KiCad (project-kicad/ e similares) — artefatos gerados
# Mantém versionados: .kicad_pro, .kicad_pcb, .kicad_sch, bibliotecas (mylib/,
# libjlc/), tabelas de biblioteca, BOM.csv, datasheets e imagens de referência.
# -----------------------------------------------------------------------------
fp-info-cache
*.kicad_prl
*.lck
~*
*.kicad_pcb-bak
*.kicad_pcb.bak
*.kicad_sch-bak
*.kicad_sch.bak
*.kicad_pro-bak
*.kicad_pro.bak
*-backups/
production/
*_drc_violations.json
*.dsn
datasheet.zip

# -----------------------------------------------------------------------------
# Logs, dados e bancos locais
# -----------------------------------------------------------------------------
logs/
data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# Ambiente e segredos
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem

# -----------------------------------------------------------------------------
# Sistema operacional
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Arquivos compactados (evita versionar binários grandes: datasheet.zip,
# mylib.zip); regere localmente quando necessário.
# -----------------------------------------------------------------------------
*.zip
*.tar.gz
